# Local development defaults (match compose.yaml)
DATABASE_URL=postgresql://rolloutlab:rolloutlab@localhost:5432/rolloutlab
REDIS_URL=redis://localhost:6379
API_PORT=4000
WEB_PORT=3000

# Flag snapshot the storefront evaluates locally. Unset = apps/web/flags/development.json.
# A missing or invalid snapshot keeps every flag at its default (off).
ROLLOUTLAB_FLAG_SNAPSHOT=

# Metrics worker: API it reads telemetry from and writes metrics to, the user it
# acts as (needs owner or editor), and comma-separated workspace/flag/environment targets.
ROLLOUTLAB_API_URL=http://localhost:4000
ROLLOUTLAB_WORKER_USER=bob
ROLLOUTLAB_METRICS_TARGETS=storefront/new-checkout/production
ROLLOUTLAB_METRICS_WINDOW_MINUTES=15
ROLLOUTLAB_WORKER_INTERVAL_MS=30000
